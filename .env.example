# Required: Generate a strong random key
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key

# Set to "true" for local dev, "false" for production
DJANGO_DEBUG=true

# Comma-separated — always include localhost for dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins for CSRF (optional for local dev, required for prod)
DJANGO_CSRF_TRUSTED_ORIGINS=
